# Dunex Environment Configuration
DUNEX_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & Secrets
DUNEX_API_TOKENS=dunex-sec-prod-token,dunex-agent-key-2026
DUNEX_HASH_SALT=your-high-entropy-salt-for-pii-hashing

# Audit Storage Backend: "memory", "jsonl", or "dynamodb"
DUNEX_AUDIT_BACKEND=memory
DUNEX_AUDIT_PATH=audit_logs.jsonl

# AWS DynamoDB (Required only when DUNEX_AUDIT_BACKEND=dynamodb)
AWS_REGION=us-east-1
DUNEX_DYNAMODB_TABLE=dunex_audit_logs
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
